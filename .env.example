# Optional locally (`memory`); required as `supabase` on production/Vercel.
RELAYPASS_DEMO_STORE=

# Required on production/Vercel. Use at least 32 random bytes and keep it server-only.
RELAYPASS_DEMO_SIGNING_SECRET=

# Required with the Supabase store. URL must be an HTTPS origin; key must be sb_secret_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
